BRIDGE_URL=ws://10.0.0.58:3001
BRIDGE_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
MC_HOST=10.0.0.58
MC_PORT=25565
RCON_PORT=25576
RCON_PASSWORD=
LM_BASE_URL=http://10.0.0.162:1234
LM_API_TOKEN=
# Exact IDs from GET /v1/models. Bionic itself is NOT a model ID.
REASON_MODEL=meta/muse-glimmer
DIALOG_MODEL=meta/muse-glimmer
# Set true only when /api/v1/models/load is available. Model values then use model keys.
LM_AUTO_LOAD=false
LM_STRUCTURED=true
LM_TIMEOUT_MS=120000
LOOP_MS=10000
STATE_DIR=/var/lib/sid-local
AGENTS_FILE=config/agents.json
# Reasoning models (e.g. Muse Glimmer) think before answering; "low" keeps turns fast. Empty omits the parameter.
LM_REASONING_EFFORT=low
LM_MAX_TOKENS=4000
# Optional x,z,radius hint matching the plugin spawn/roam-radius (keep a few blocks inside it).
ROAM_AREA=272.5,96.5,44
MIN_MOVE_BLOCKS=6
# uuid=name pairs so agents can address players by name.
PLAYER_NAMES=

# LLM router: primary (player-facing, planning) and offload server (background work), each the other's backup.
# PRIMARY_* default to LM_BASE_URL / LM_API_TOKEN / REASON_MODEL when left out.
PRIMARY_LLM_URL=http://10.0.0.162:1234
PRIMARY_LLM_KEY=REPLACE_WITH_LM_STUDIO_TOKEN
PRIMARY_LLM_MODEL=meta/muse-glimmer
OFFLOAD_LLM_URL=http://10.0.0.45:1234/v1
OFFLOAD_LLM_KEY=lm-studio
# The configured model if loaded there, otherwise the model loaded on that server.
OFFLOAD_LLM_MODEL=gemma-4-12B-it-qat-q4_0.gguf
# Give up on a server that has not started answering within this time (ms), then try the other one.
PRIMARY_FIRST_BYTE_MS=10000
UTILITY_FIRST_BYTE_MS=5000
# Reload the offload model without a speculative draft model if LM Studio loads one (made Gemma 11x slower).
OFFLOAD_DISABLE_DRAFT=true
# Requests the offload server runs at once (its LM Studio "parallel" setting): 4 with Gemma 12B at 64k context on the RX 9070 XT.
OFFLOAD_PARALLEL=4
# With both models online they share the load, repair and review each other, and escalate hard problems (false = fixed routing).
LLM_TEAMWORK=true
# Minimum context for the offload model (its slots share it); the router reloads it with this much if it comes back smaller
OFFLOAD_MIN_CONTEXT=65536
# Requests Muse runs at once (LM Studio parallel on the 4090)
PRIMARY_PARALLEL=4
# Optional model tuning: seconds a started server may take to produce its first token; per-model reasoning
# (Gemma gets "none" automatically); fold the system prompt into the user turn (true for models without a system role).
FIRST_TOKEN_MS=120000
#OFFLOAD_REASONING_EFFORT=none
#OFFLOAD_FOLD_SYSTEM=true
# Agents thinking at once (capped by the servers' slots).
AGENT_CONCURRENCY=6

# Dashboard (http://<this host>:DASHBOARD_PORT/?key=REPLACE_WITH_DASHBOARD_TOKEN). Without a token anyone on the LAN can use it.
DASHBOARD_PORT=8088
DASHBOARD_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN
# Browsers from these networks need no key (comma-separated IPv4 CIDRs; "none" = always require the key).
DASHBOARD_TRUSTED_NETS=10.0.0.0/24,127.0.0.1/32
# Player name used for commands sent from the dashboard (that player must be in the game).
DASHBOARD_PLAYER=

# Cognition: the model plans only when something calls for it (false = every loop); heartbeat between plans (ms).
THINK_GATING=true
THINK_HEARTBEAT_MS=300000
# Personality reflection every N planning turns.
EVOLVE_EVERY_TURNS=15
# memory.json is written at most this often (ms) when it changed, and always at shutdown.
MEMORY_SAVE_MS=30000

# World: build reach in blocks (match build-reach in the plugin config); village homes file.
BUILD_REACH=10
VILLAGE_FILE=config/village.json
# The citizens may build anywhere (the plugin's roam-radius: 0). true = keep blueprints inside ROAM_AREA again.
LIMIT_TO_HOME=false

# Town life: council every N days; crime on/off; chance of a visitor arriving each day (0-1).
COUNCIL_EVERY_DAYS=7
CRIME=on
VISITOR_CHANCE=0.35
